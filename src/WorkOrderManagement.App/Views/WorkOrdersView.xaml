<UserControl x:Class="WorkOrderManagement.App.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:WorkOrderManagement.App.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:PriorityToColorConverter x:Key="PriorityColor"/>
        <conv:StatusToColorConverter x:Key="StatusColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseVisible"/>
        <conv:StringToVisibilityConverter x:Key="StringVisible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="99"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}">
            <Rectangle Fill="#80000000"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyMessage}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Dashboard Cards -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="20,12" Orientation="Horizontal">

                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconClipboard}" Fill="{StaticResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TOTAL" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Total}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconAlert}" Fill="#3B82F6"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Open}" FontSize="24" FontWeight="Bold" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconGear}" Fill="#A855F7"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="IN PROGRESS" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.InProgress}" FontSize="24" FontWeight="Bold" Foreground="#A855F7"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconCheckCircle}" Fill="#22C55E"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="COMPLETED" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Completed}" FontSize="24" FontWeight="Bold" Foreground="#22C55E"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconLightning}" Fill="#EF4444"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="HIGH PRIORITY" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.HighPriority}" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconClock}" Fill="#F59E0B"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OVERDUE" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Overdue}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,8">
            <WrapPanel VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconFilter}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Filter:" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Width="135" Margin="0,0,12,0"/>

                <TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding PriorityFilterOptions}"
                          SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Width="135" Margin="0,0,12,0"/>

                <Button Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Padding="10,6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}"
                              Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringVisible}}"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid Area -->
        <Grid Grid.Row="2" Margin="20,12">
            <DataGrid ItemsSource="{Binding WorkOrders}"
                      SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                      IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      CellStyle="{StaticResource ModernDataGridCellStyle}"
                      Visibility="{Binding HasWorkOrders, Converter={StaticResource BoolVisible}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"
                                        ElementStyle="{StaticResource BodyStyle}"/>

                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"
                                        ElementStyle="{StaticResource BodyStyle}"/>

                    <DataGridTemplateColumn Header="PRIORITY" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2"
                                        Background="{Binding Priority, Converter={StaticResource PriorityColor}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Priority, Converter={StaticResource EnumDisplay}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="STATUS" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2"
                                        Background="{Binding Status, Converter={StaticResource StatusColor}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TECHNICIAN"
                                        Binding="{Binding AssignedTechnician.FullName}"
                                        Width="160"
                                        ElementStyle="{StaticResource BodyStyle}"/>

                    <DataGridTextColumn Header="DATE LOGGED"
                                        Binding="{Binding DateLogged, StringFormat={}{0:dd MMM yyyy}}"
                                        Width="120"
                                        ElementStyle="{StaticResource BodyStyle}"/>

                    <DataGridTextColumn Header="TARGET DATE"
                                        Binding="{Binding TargetCompletionDate, StringFormat={}{0:dd MMM yyyy}}"
                                        Width="120"
                                        ElementStyle="{StaticResource BodyStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasWorkOrders, Converter={StaticResource InverseVisible}}">
                <Border Width="64" Height="64" Background="{StaticResource CardBrush}" CornerRadius="16"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Data="{StaticResource IconClipboard}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="28" Height="28" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                </Border>
                <TextBlock Text="No work orders found."
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Try adjusting your filters or add a new work order."
                           Style="{StaticResource SubheadingStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <WrapPanel>
                <Button Command="{Binding AddWorkOrderCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="White"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Work Order" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditWorkOrderCommand}"
                        IsEnabled="{Binding IsWorkOrderSelected}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextPrimaryBrush}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteWorkOrderCommand}"
                        IsEnabled="{Binding IsWorkOrderSelected}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTrash}" Fill="White"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
