<UserControl x:Class="WorkOrderManagement.App.Views.TechniciansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:WorkOrderManagement.App.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseVisible"/>
        <conv:StringToVisibilityConverter x:Key="StringVisible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="99"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}">
            <Rectangle Fill="#80000000"/>
            <TextBlock Text="{Binding BusyMessage}"
                       FontSize="18" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Technicians" Style="{StaticResource HeadingStyle}"/>
                    <TextBlock Text="Manage your maintenance team" Style="{StaticResource SubheadingStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource SubheadingStyle}"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringVisible}}"/>
            </Grid>
        </Border>

        <!-- Technicians DataGrid -->
        <Grid Grid.Row="1" Margin="20,12">
            <DataGrid ItemsSource="{Binding Technicians}"
                      SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}"
                      IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      CellStyle="{StaticResource ModernDataGridCellStyle}"
                      Visibility="{Binding HasTechnicians, Converter={StaticResource BoolVisible}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"
                                        ElementStyle="{StaticResource BodyStyle}"/>
                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"
                                        ElementStyle="{StaticResource BodyStyle}"/>
                    <DataGridTextColumn Header="SPECIALTY" Binding="{Binding Specialty}" Width="200"
                                        ElementStyle="{StaticResource BodyStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasTechnicians, Converter={StaticResource InverseVisible}}">
                <Border Width="64" Height="64" Background="{StaticResource CardBrush}" CornerRadius="16"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Data="{StaticResource IconUsers}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="28" Height="28" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                </Border>
                <TextBlock Text="No technicians found."
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Add a technician to get started."
                           Style="{StaticResource SubheadingStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <WrapPanel>
                <Button Command="{Binding AddTechnicianCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="White"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Technician" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditTechnicianCommand}"
                        IsEnabled="{Binding IsTechnicianSelected}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextPrimaryBrush}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteTechnicianCommand}"
                        IsEnabled="{Binding IsTechnicianSelected}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTrash}" Fill="White"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
