<Window x:Class="WorkOrderManagement.App.Views.AddEditWorkOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WorkOrderManagement.App.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="600" SizeToContent="Height"
        MaxHeight="820"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay"/>
        <conv:PriorityToColorConverter x:Key="PriorityColor"/>
        <conv:StatusToColorConverter x:Key="StatusColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:StringToVisibilityConverter x:Key="StringVisible"/>

        <!-- Preset Date Chip Button Style -->
        <Style x:Key="DatePresetButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="*"/>      <!-- Form -->
            <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="99"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}">
            <Rectangle Fill="#80000000" RadiusX="8" RadiusY="8"/>
            <TextBlock Text="{Binding BusyMessage}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Dialog Title -->
        <Border Grid.Row="0" Margin="0,0,0,18"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,12,0">
                    <Path Data="{StaticResource IconClipboard}" Fill="White"
                          Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource HeadingStyle}"/>
                    <TextBlock Text="Fill in the maintenance details below" Style="{StaticResource SubheadingStyle}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Row="1">

            <!-- Title field -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="TITLE *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"/>
                <TextBlock Text="{Binding TitleError}"
                           Style="{StaticResource ErrorTextStyle}"
                           Visibility="{Binding TitleError, Converter={StaticResource StringVisible}}"/>
            </StackPanel>

            <!-- Description field -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="DESCRIPTION" Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="75"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Priority and Status row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Priority -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRIORITY *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                              SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                            Background="{Binding Converter={StaticResource PriorityColor}}"/>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATUS *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                            Background="{Binding Converter={StaticResource StatusColor}}"/>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Target Completion Date Section -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="TARGET COMPLETION DATE *" Style="{StaticResource FormLabelStyle}"
                                   VerticalAlignment="Center"/>
                        <!-- Date summary badge -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource AccentBrush}"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetDateSummary}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <DatePicker SelectedDate="{Binding TargetCompletionDate, Mode=TwoWay}"
                                    Style="{StaticResource ModernDatePickerStyle}"
                                    IsEnabled="{Binding IsHighPriority, Converter={StaticResource InverseBool}}"/>
                    </Grid>

                    <!-- Quick Preset Date Chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding IsHighPriority, Converter={StaticResource InverseBool}}">
                        <TextBlock Text="Quick presets:" Style="{StaticResource SubheadingStyle}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="+1 Day" Style="{StaticResource DatePresetButtonStyle}"
                                Command="{Binding SetTargetDaysCommand}" CommandParameter="1"/>
                        <Button Content="+3 Days" Style="{StaticResource DatePresetButtonStyle}"
                                Command="{Binding SetTargetDaysCommand}" CommandParameter="3"/>
                        <Button Content="+1 Week" Style="{StaticResource DatePresetButtonStyle}"
                                Command="{Binding SetTargetDaysCommand}" CommandParameter="7"/>
                        <Button Content="+2 Weeks" Style="{StaticResource DatePresetButtonStyle}"
                                Command="{Binding SetTargetDaysCommand}" CommandParameter="14"/>
                        <Button Content="+1 Month" Style="{StaticResource DatePresetButtonStyle}"
                                Command="{Binding SetTargetDaysCommand}" CommandParameter="30"/>
                    </StackPanel>

                    <!-- High priority warning note -->
                    <Border Background="#3B2607" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6"
                            Padding="10,6" Margin="0,8,0,0"
                            Visibility="{Binding IsHighPriority, Converter={StaticResource BoolVisible}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLightning}" Fill="#F59E0B"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HighPriorityNote}"
                                       Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Assigned Technician -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="ASSIGNED TECHNICIAN" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox ItemsSource="{Binding Technicians}"
                          SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}"
                          Style="{StaticResource ModernComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource TextSecondaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding FullName}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="-- Unassigned --"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Select a technician to assign or choose '-- Unassigned --'."
                           Style="{StaticResource SubheadingStyle}"
                           FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- General error -->
            <Border Background="#3B1B1B" CornerRadius="6" Padding="12,8"
                    Visibility="{Binding GeneralError, Converter={StaticResource StringVisible}}">
                <TextBlock Text="{Binding GeneralError}"
                           Foreground="#EF4444" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSave}" Fill="White"
                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Save Work Order" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
